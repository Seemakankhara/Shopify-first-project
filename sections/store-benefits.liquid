
<section class="store-benefits">
  <div class="store-benefits__grid">
    {% for block in section.blocks %}
      <div
        class="store-benefits__item"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.icon != 'none' %}
          <div class="store-benefits__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'shipping' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"
                    stroke="currentColor" stroke-width="1.5"
                    stroke-linejoin="round"/>
                  <circle cx="7.5" cy="18" r="2"
                    stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="17.5" cy="18" r="2"
                    stroke="currentColor" stroke-width="1.5"/>
                </svg>
              {% when 'returns' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 11a9 9 0 1 1 2.6 6.4M3 4v7h7"
                    stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'secure' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 3 20 6v5c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6z"
                    stroke="currentColor" stroke-width="1.5"
                    stroke-linejoin="round"/>
                  <path d="m8.5 12 2.3 2.3 4.7-4.7"
                    stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 13v-2a8 8 0 0 1 16 0v2"
                    stroke="currentColor" stroke-width="1.5"/>
                  <rect x="3" y="12" width="4" height="6" rx="2"
                    stroke="currentColor" stroke-width="1.5"/>
                  <rect x="17" y="12" width="4" height="6" rx="2"
                    stroke="currentColor" stroke-width="1.5"/>
                  <path d="M19 18c0 2-2 3-5 3"
                    stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round"/>
                </svg>
            {% endcase %}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h3 class="store-benefits__heading">
            {{ block.settings.heading | escape }}
          </h3>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="store-benefits__description">
            {{ block.settings.description | escape }}
          </p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .store-benefits {
    width: 100%;
    box-sizing: border-box;
    padding: 48px 24px;
    background: #ffffff;
    color: #222222;
  }

  .store-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    width: min(100%, 1200px);
    margin-inline: auto;
  }

  .store-benefits__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 12px;
  }

  .store-benefits__icon svg {
    display: block;
    width: 32px;
    height: 32px;
  }

  .store-benefits__heading {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
  }

  .store-benefits__description {
    margin: 8px 0 0;
    color: #666666;
    font-size: 14px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .store-benefits {
      padding: 32px 16px;
    }

    .store-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 12px;
    }

    .store-benefits__item {
      padding: 8px 4px;
    }

    .store-benefits__heading {
      font-size: 14px;
    }

    .store-benefits__description {
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store benefits",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "returns",
              "label": "Returns"
            },
            {
              "value": "secure",
              "label": "Secure checkout"
            },
            {
              "value": "support",
              "label": "Customer support"
            },
            {
              "value": "none",
              "label": "No icon"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On qualifying orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store benefits",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "heading": "Easy Returns",
            "description": "A simple return process"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "secure",
            "heading": "Secure Checkout",
            "description": "Shop with confidence"
          }
        }
      ]
    }
  ]
}
{% endschema %}
