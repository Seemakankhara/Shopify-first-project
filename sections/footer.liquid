
<footer class="store-footer">
  <div class="store-footer__inner">

    <div class="store-footer__main">

      
<div class="store-footer__brand" style="--footer-logo-width: {{ section.settings.footer_logo_width }}px;">
  <a
    class="store-footer__brand-link"
    href="{{ routes.root_url }}"
    aria-label="{{ shop.name | escape }}"
  >
    {% if section.settings.footer_logo != blank %}
      {{
        section.settings.footer_logo
        | image_url: width: 480
        | image_tag:
          widths: '120, 180, 240, 360, 480',
          alt: shop.name,
          class: 'store-footer__logo-image'
      }}
    {% else %}
      <span class="store-footer__brand-name">
        {{ shop.name | escape }}
      </span>
    {% endif %}
  </a>
</div>


      <div class="store-footer__navigation">
        <h2 class="store-footer__heading">
          {{ section.settings.menu_heading | escape }}
        </h2>

        {% if section.settings.menu != blank %}
          <nav aria-label="{{ section.settings.menu_heading | escape }}">
            <ul class="store-footer__menu">
              {% for link in section.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}">
                    {{ link.title | escape }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </nav>
        {% else %}
          <p class="store-footer__hint">
            Select a menu in the footer settings.
          </p>
        {% endif %}
      </div>

      {% if section.settings.show_newsletter %}
        <div class="store-footer__newsletter">
          <h2 class="store-footer__heading">
            {{ section.settings.newsletter_heading | escape }}
          </h2>

          {% if section.settings.newsletter_description != blank %}
            <p class="store-footer__description">
              {{ section.settings.newsletter_description | escape }}
            </p>
          {% endif %}

          {% form 'customer', id: 'FooterNewsletterForm', class: 'store-footer__form' %}
            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <label
              class="store-footer__visually-hidden"
              for="FooterNewsletterEmail-{{ section.id }}"
            >
              Email address
            </label>

            <div class="store-footer__form-row">
              <input
                id="FooterNewsletterEmail-{{ section.id }}"
                class="store-footer__email"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="Enter your email address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >

              <button
                class="store-footer__submit"
                type="submit"
                name="commit"
              >
                Subscribe
              </button>
            </div>

            {% if form.errors %}
              <div class="store-footer__form-message" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            {% if form.posted_successfully? %}
              <p class="store-footer__form-message" role="status">
                Thank you for subscribing!
              </p>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}

    </div>

    <div class="store-footer__bottom">

      <p class="store-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name | escape }}.
      </p>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
        <ul class="store-footer__payments" aria-label="Accepted payment methods">
          {% for type in shop.enabled_payment_types %}
            <li>
              {{ type | payment_type_svg_tag }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    </div>

  </div>
</footer>

{% stylesheet %}
  .store-footer {
    width: 100%;
    box-sizing: border-box;
    margin-top: 48px;
    padding: 56px 24px 24px;
    background: #202124;
    color: #ffffff;
    grid-column: 1 / -1;
  }

  .store-footer__inner {
    width: min(100%, 1320px);
    margin-inline: auto;
  }

  .store-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(140px, 0.65fr) minmax(280px, 1fr);
    gap: 48px;
    padding-bottom: 48px;
  }

  .store-footer__brand-link {
    display: inline-block;
    color: #ffffff;
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .store-footer__description {
    margin: 14px 0 0;
    color: #c8c8c8;
    font-size: 14px;
    line-height: 1.7;
  }

  .store-footer__heading {
    margin: 0 0 18px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
  }

  .store-footer__menu {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .store-footer__menu a {
    color: #c8c8c8;
    font-size: 14px;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .store-footer__menu a:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .store-footer__hint {
    color: #c8c8c8;
    font-size: 13px;
  }

  .store-footer__form-row {
    display: flex;
    gap: 8px;
    margin-top: 18px;
  }

  .store-footer__email {
    width: 100%;
    min-width: 0;
    min-height: 46px;
    box-sizing: border-box;
    padding: 12px;
    border: 1px solid #686868;
    border-radius: 4px;
    background: #ffffff;
    color: #202124;
    font: inherit;
    font-size: 13px;
  }

  .store-footer__submit {
    flex-shrink: 0;
    min-height: 46px;
    padding: 12px 16px;
    border: 1px solid #ffffff;
    border-radius: 4px;
    background: #ffffff;
    color: #202124;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .store-footer__submit:hover {
    background: transparent;
    color: #ffffff;
  }

  .store-footer__email:focus-visible,
  .store-footer__submit:focus-visible,
  .store-footer a:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .store-footer__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .store-footer__form-message {
    margin-top: 12px;
    color: #ffffff;
    font-size: 13px;
    line-height: 1.5;
  }

  .store-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid #494949;
  }

  .store-footer__copyright {
    margin: 0;
    color: #c8c8c8;
    font-size: 12px;
    line-height: 1.6;
  }

  .store-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .store-footer__payments svg {
    display: block;
    width: 38px;
    height: auto;
  }
.store-footer__brand-link {
  display: inline-flex;
  align-items: center;
  color: #ffffff;
  text-decoration: none;
}

.store-footer__brand-name {
  font-size: 25px;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.store-footer__logo-image {
  display: block;
  width: auto;
  max-width: min(var(--footer-logo-width, 160px), 100%);
  height: auto;
}
  @media screen and (max-width: 900px) {
    .store-footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 28px;
    }

    .store-footer__newsletter {
      grid-column: 1 / -1;
      max-width: 520px;
    }
  }

  @media screen and (max-width: 600px) {
    .store-footer {
      margin-top: 32px;
      padding: 40px 20px 20px;
    }

    .store-footer__main {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-bottom: 32px;
    }

    .store-footer__newsletter {
      grid-column: auto;
    }

    .store-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .store-footer__payments {
      justify-content: flex-start;
    }

    .store-footer__form-row {
      flex-wrap: wrap;
    }

    .store-footer__submit {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store-footer__menu a,
    .store-footer__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store footer",
  "settings": [
    
{
  "type": "image_picker",
  "id": "footer_logo",
  "label": "Footer logo"
},
{
  "type": "range",
  "id": "footer_logo_width",
  "label": "Footer logo width",
  "min": 80,
  "max": 300,
  "step": 10,
  "unit": "px",
  "default": 160
},

    {
      "type": "textarea",
      "id": "description",
      "label": "Store description",
      "default": "Sound for every part of your day."
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Menu heading",
      "default": "Quick Links"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay Connected"
    },
    {
      "type": "textarea",
      "id": "newsletter_description",
      "label": "Newsletter description",
      "default": "Get updates on new products and offers."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
