
<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__brand" style="--header-logo-width: {{ section.settings.logo_width }}px;">
      <a
        href="{{ routes.root_url }}"
        class="site-header__brand-link"
        aria-label="{{ shop.name | escape }}"
      >
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 480
            | image_tag:
              widths: '120, 180, 240, 360, 480',
              alt: shop.name,
              class: 'site-header__logo-image'
          }}
        {% else %}
          <span class="site-header__store-name">
            {{ shop.name | escape }}
          </span>
        {% endif %}
      </a>
    </div>

    <nav class="site-header__navigation" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a
            href="{{ link.url }}"
            class="site-header__nav-link"
          >
            {{ link.title | escape }}
          </a>
        {% endfor %}
      {% endif %}
    </nav>

    <div class="site-header__actions">

    
<details class="site-header__mobile-menu">
  
<summary aria-label="Toggle navigation menu">
        <svg
          class="site-header__menu-icon site-header__menu-icon--hamburger"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
        >
          <path
            d="M3 6H21M3 12H21M3 18H21"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>

        <svg
          class="site-header__menu-icon site-header__menu-icon--close"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
        >
          <path
            d="M6 6L18 18M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
</summary>


  <nav class="site-header__mobile-navigation" aria-label="Mobile navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">
          {{ link.title | escape }}
        </a>
      {% endfor %}
    {% endif %}
  </nav>
</details>

      <a
        href="{{ routes.search_url }}"
        class="site-header__icon-link"
        aria-label="Search"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.6"/>
          <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <shopify-account
          menu="{{ section.settings.customer_account_menu }}"
        >
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a
        href="{{ routes.cart_url }}"
        class="site-header__icon-link site-header__cart-link"
        aria-label="Cart{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}

        {% if cart.item_count > 0 %}
          <span class="site-header__cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
      background: var(--brand-surface);
  color: var(--brand-text);
  border-bottom: 1px solid var(--brand-border);
  }

  .site-header__inner {
    width: min(100% - 64px, 1440px);
    min-height: 88px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto minmax(100px, 1fr);
    align-items: center;
    gap: 32px;
  }

  .site-header__brand {
    min-width: 0;
  }

  .site-header__brand-link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .site-header__store-name {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .site-header__logo-image {
  display: block;
  width: auto;
  max-width: min(var(--header-logo-width, 160px), 100%);
  height: auto;
}

  .site-header__navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
  }

  .site-header__nav-link {
    position: relative;
    padding-block: 8px;
    color: inherit;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav-link::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    background: var(--brand-primary);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
  }

  .site-header__icon-link {
    position: relative;
    display: inline-flex;
    width: 36px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }

  .site-header__icon-link svg,
  .site-header__actions shopify-account svg {
    display: block;
    width: 23px;
    height: 23px;
  }

  .site-header__cart-count {
    position: absolute;
    top: 0;
    right: -5px;
    display: grid;
    min-width: 18px;
    height: 18px;
    padding-inline: 3px;
    place-items: center;
    border-radius: 50%;
    background: var(--brand-primary);
  color: var(--brand-button-text);
    font-size: 10px;
    line-height: 1;
  }

  .site-header__brand-link:focus-visible,
  .site-header__nav-link:focus-visible,
  .site-header__icon-link:focus-visible {
    outline: 2px solid #225edb;
    outline-offset: 4px;
  }
.site-header__mobile-menu {
  display: none;
}

.site-header__mobile-menu summary {
  display: flex;
  width: 40px;
  height: 44px;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  list-style: none;
}

.site-header__mobile-menu summary::-webkit-details-marker {
  display: none;
}

.site-header__mobile-menu summary svg {
  width: 23px;
  height: 23px;
}

.site-header__mobile-navigation {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.site-header__mobile-navigation a {
  display: block;
  padding: 16px 20px;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid #eeeeeb;
}

.site-header__mobile-navigation a:hover {
  background: #f8f8f6;
}

.site-header__mobile-navigation a:focus-visible,
.site-header__mobile-menu summary:focus-visible {
  outline: 2px solid #225edb;
  outline-offset: 2px;
}
  @media screen and (max-width: 989px) {
    .site-header__inner {
      width: calc(100% - 40px);
      grid-template-columns: minmax(100px, 1fr) auto;
      gap: 20px;
    }

    .site-header__navigation {
      display: none;
    }

    .site-header__actions {
      gap: 12px;
    }
    .site-header__mobile-menu {
    display: block;
    position: static;
  }

  .site-header__mobile-menu[open] .site-header__mobile-navigation {
    position: absolute;
   top: 98%;
    left: 0;
    right: 0;
    width: auto;
    max-width: 100%;
    box-sizing: border-box;
    background: #ffffff;
    color: #202020;
    border: 1px solid #eeeeeb;
    border-radius: 0 0 6px 6px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 10%);
    z-index: 20;
  }
   .site-header__actions {
    gap: 8px;
  }
  
.site-header__menu-icon {
  display: block;
  width: 23px;
  height: 23px;
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.site-header__menu-icon--close {
  display: none;
}

.site-header__mobile-menu[open] .site-header__menu-icon--hamburger {
  display: none;
}

.site-header__mobile-menu[open] .site-header__menu-icon--close {
  display: block;
}

  }

  @media screen and (max-width: 480px) {
    .site-header__inner {
      width: calc(100% - 32px);
      min-height: 72px;
      gap: 12px;
    }

    .site-header__store-name {
      font-size: 20px;
    }

    .site-header__actions {
      gap: 6px;
    }

    .site-header__icon-link {
      width: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__nav-link::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
